# DevCollab Backend Environment Configuration Template

# Server Port & Environment
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.cuczqlt.mongodb.net/devcollab?retryWrites=true&w=majority

# JWT Authentication Config
JWT_SECRET=replace_with_a_long_random_cryptographic_secret_key_in_production
JWT_EXPIRES_IN=7d

# Frontend Allowed Origin (CORS and Socket.IO handshake origin)
# In production, set to your Vercel URL (e.g. https://devcollab.vercel.app)
CLIENT_URL=http://localhost:5173

# Cross-Origin Cookie Security Settings (Essential for cross-domain Vercel <-> Render hosting)
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
